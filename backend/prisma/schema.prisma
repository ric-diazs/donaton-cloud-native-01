// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelos de datos

// Los atributos @@map() y @map() sirven para renombrar las tablas y las columnas
// luego de ser creadas por Prisma.
// Mas info en:
//    https://www.prisma.io/docs/orm/prisma-client/setup-and-configuration/custom-model-and-field-names#using-map-and-map-to-rename-fields-and-models-in-the-prisma-client-api
enum Rol {
    ADMIN
    VOLUNTARIO
    COLABORADOR
}

model Usuario {
    id        Int @id @default(autoincrement())
    supabaseId String @unique @map("supabase_id") // almacena el id (un GUUID) generado por Supabase en tabla 'auth.users'
    nombre    String @db.VarChar(100)
    correo    String @db.VarChar(50) @unique
    //password  String @db.VarChar(255) // Supabase con su tabla auth.users se hara cargo de su gestion
    rol       Rol @default(VOLUNTARIO)
    nombreOrg String? @db.VarChar(100) @map("nombre_org")
    creadoEn  DateTime @default(now()) @map("creado_en")

    @@map("usuario")
}

model Donacion {
    id            Int @id @default(autoincrement())
    tipo          String @db.VarChar(100)
    cantidad      Int
    peso          Decimal
    nombreDonante String? @db.VarChar(100) @map("nombre_donante")
    correoDonante String @db.VarChar(50) @map("correo_donante")
    creadoEn      DateTime @default(now()) @map("creado_en")

    @@map("donacion")
}

model Necesidad {
    id                Int @id @default(autoincrement())
    tipoNecesidad     String @db.VarChar(50) @map("tipo_necesidad")
    descripcion       String @db.VarChar(255)
    prioridad         String @db.VarChar(15)
    comunidadAfectada String @db.VarChar(100) @map("comunidad_afectada")
    creadoEn          DateTime @default(now()) @map("creado_en")

    @@map("necesidad")
}

